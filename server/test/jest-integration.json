{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".integration-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverage": true,
  "coverageDirectory": "./coverage",
  "coverageReporters": ["json", "lcov", "text"],
  "coveragePathIgnorePatterns": ["node_modules", ".entity.ts", ".module.ts"],
  "collectCoverageFrom": [
    "src/**/*.(t|j)s",
    "!src/main.ts",
    "!src/**/*.module.ts",
    "!src/**/*.dto.ts",
    "!src/**/*.decorator.ts",
    "!src/**/*.spec.ts",
    "!**/node_modules/**",
    "!**/coverage/**",
    "!**/coverage-e2e/**",
    "!**/*.js"
  ],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  }
}
